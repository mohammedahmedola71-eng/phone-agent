# Required: one or more comma-separated app tokens. Generate: openssl rand -hex 24
VOX_APP_TOKENS=replace-me

# anthropic | openai | mock (mock needs no key and just echoes - for first-run testing)
VOX_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Limits (per app token)
VOX_RPM=30
VOX_RPD=500
VOX_IMAGES_PER_DAY=2000
VOX_MAX_IMAGES=32
PORT=8787
